
ARG VLLM_TAG=v0.18.0
FROM vllm/vllm-openai:${VLLM_TAG}

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    HF_HOME=/root/.cache/huggingface

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ffmpeg \
        git \
        curl \
        libsndfile1 \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/requirements-asr.txt /app/requirements-asr.txt

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages \
        -r /app/requirements-asr.txt

COPY deployment/ /app/deployment/
COPY qwen_asr/ /app/qwen_asr/

EXPOSE 8000 8265 6379

ENTRYPOINT ["serve", "run", "deployment.asr_serve:build_app"]
